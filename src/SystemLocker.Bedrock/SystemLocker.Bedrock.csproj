<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>SystemLocker.Bedrock</PackageId>
    <Version>0.1.0</Version>
    <Authors>System Locker</Authors>
    <Description>Official System Locker Bedrock client for .NET — Ed25519-signed responses, rotating session tokens, and per-request challenges for software on untrusted machines.</Description>
    <PackageProjectUrl>https://github.com/systemlocker/System-Locker-Bedrock-NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/systemlocker/System-Locker-Bedrock-NET</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SystemLocker.Bedrock.Tests" />
  </ItemGroup>

</Project>
